# Server
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO

# Where the web app runs. Headless Chromium navigates here to render PDFs, so
# it must be reachable from this process. A wrong value shows up as a PDF
# export timeout naming this URL.
WEB_BASE_URL=http://localhost:3000

# Local-first: nothing leaves the machine unless you point this elsewhere.
# Ollama defaults to a 4096-token context and silently truncates the FRONT of
# an oversized prompt, which is where the system prompt and tool schemas live.
# Use a model tagged with an explicit num_ctx rather than a bare tag; the
# recipes in models/ build them.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b-16k
LLM_API_BASE=http://localhost:11434
LLM_API_KEY=

# How many tokens a turn may generate. 2048 was too tight: a model that thinks
# out loud can spend the whole budget inside its reasoning block and stop before
# writing either a reply or a tool call, so the turn silently does nothing.
LLM_MAX_TOKENS=4096
